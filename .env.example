# Copy to .env and fill in (never commit .env)
# Used by: ./scripts/run-login-test.sh (sources this file automatically)

# App package (default in .maestro/config.yaml)
# APP_ID=com.macadamapp.beta

# Password login (works today with mock server)
MAESTRO_EMAIL=your-name+maestro@macadam.app
MAESTRO_PASSWORD=

# Sign-up: leave MAESTRO_EMAIL empty for random maestro.e2e.*@macadam.app per run
# MAESTRO_EMAIL=

# Custom-token login (future — after BE ships E2E token endpoint)
# MAESTRO_E2E_SECRET=
# MAESTRO_E2E_TOKEN_URL=https://macadam-core.preprod.macadam.app/users/e2e/custom-token

# App-side only (in ~/macadam-app/.env.development — not this file):
# E2E_TESTING=true
# BASE_URL=http://localhost:4010
